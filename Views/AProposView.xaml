<UserControl x:Class="GestionCommerciale.Views.AProposView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">

            <Image Source="pack://application:,,,/Resources/kahuzi_emblem_white.png"
                   Width="80" Height="80"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="8" ShadowDepth="0" />
                </Image.Effect>
            </Image>

            <TextBlock Text="{Binding NomApplication}" FontSize="26" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,16,0,0"
                       Foreground="{DynamicResource HeadingForegroundBrush}" />

            <TextBlock Text="Gestion commerciale — Bukavu Enterprise" Opacity="0.7"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />

            <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Opacity="0.5"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,24" />

            <materialDesign:Card Style="{StaticResource SectionCard}" Margin="0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Conçue par Metoushela Walker" FontWeight="Bold" FontSize="16"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="Développeur logiciel — Bukavu, RDC" Opacity="0.7"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Merci d'utiliser Kahuzi ERP. Cette application a été développée sur mesure pour la gestion commerciale au quotidien : stock, clients et ventes en un seul endroit." />
                </StackPanel>
            </materialDesign:Card>

            <TextBlock HorizontalAlignment="Center" Opacity="0.4" FontSize="11" Margin="0,24,0,0">
                <Run Text="© " /><Run Text="{Binding AnneeCourante}" /><Run Text=" Kahuzi ERP. Tous droits réservés." />
            </TextBlock>

        </StackPanel>
    </Grid>
</UserControl>