<UserControl x:Class="GestionCommerciale.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <DockPanel LastChildFill="True" Margin="16">

            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Gestion des clients" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />

                <TextBox Grid.Column="2" Style="{StaticResource SearchTextBox}"
                         Text="{Binding TexteRecherche, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                         VerticalAlignment="Center" Margin="0,0,12,0" />
            </Grid>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button Content="EXPORTER CSV"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ExporterCsvCommand}"
                        Margin="0,0,8,0" />
                <Button Content="+ NOUVEAU CLIENT"
                        Style="{StaticResource PrimaryActionButton}"
                        Command="{Binding OuvrirNouveauFormulaireCommand}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding MessageErreur}" Foreground="{DynamicResource ValidationErrorBrush}"
                       Margin="0,0,0,8" TextWrapping="Wrap"
                       Visibility="{Binding MessageErreur, Converter={StaticResource StringToVisibilityConverter}}" />

            <materialDesign:Card Style="{StaticResource SectionCard}" Margin="0">
                <DataGrid ItemsSource="{Binding Clients}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          materialDesign:DataGridAssist.CellPadding="12,10"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding NomComplet}" Width="180" />
                        <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="140" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                        <DataGridTextColumn Header="Adresse" Binding="{Binding Adresse}" Width="220" />
                        <DataGridTemplateColumn Header="Actions" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.OuvrirEditionFormulaireCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="Modifier">
                                            <materialDesign:PackIcon Kind="PencilOutline" />
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.SupprimerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="Supprimer">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </DockPanel>

        <!-- Overlay formulaire -->
        <Grid Visibility="{Binding AfficherFormulaire, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#88000000">
            <materialDesign:Card Width="420" Padding="24"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding TitreFormulaire}"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,16" />

                    <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Nom" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                    <TextBox Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Prénom" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                    <TextBox Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Téléphone" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Email" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                    <TextBox Text="{Binding Adresse, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Adresse" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,20" />

                    <TextBlock Text="{Binding MessageErreur}" Foreground="{DynamicResource ValidationErrorBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="ANNULER" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding FermerFormulaireCommand}" Margin="0,0,8,0" />
                        <Button Content="ENREGISTRER" Style="{StaticResource PrimaryActionButton}"
                                Command="{Binding EnregistrerCommand}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
