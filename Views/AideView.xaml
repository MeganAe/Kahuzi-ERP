<UserControl x:Class="GestionCommerciale.Views.AideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="800" HorizontalAlignment="Left">

            <!-- En-tête -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Guide &amp; Manuel d'Utilisation" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                <TextBlock Text="Retrouvez ici l'essentiel pour maîtriser toutes les fonctionnalités de Kahuzi ERP." Opacity="0.7" FontSize="13" />
            </StackPanel>

            <!-- Guide 1 : Ventes et Facturation -->
            <materialDesign:Card Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="CartCheck" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="1. Enregistrer une Vente &amp; Imprimer une Facture" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="8,0,0,0" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Text="• Rendez-vous dans le module « Ventes » puis cliquez sur « + NOUVELLE VENTE ».&#x0a;• Choisissez le client (ou laissez client comptant), le mode de paiement (Espèces, Mobile Money, etc.).&#x0a;• Ajoutez les articles et quantités souhaités dans le panier.&#x0a;• Cliquez sur « VALIDER LA VENTE » : le stock est déduit automatiquement et vous pouvez imprimer le reçu immédiatement.&#x0a;• À tout moment, vous pouvez cliquer sur l'icône de facture dans la liste pour réimprimer un reçu passé."
                               LineHeight="22" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Guide 2 : Gestion du Stock -->
            <materialDesign:Card Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="2. Gestion du Stock &amp; Alertes de Seuil" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="8,0,0,0" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Text="• Dans l'onglet « Stock », ajoutez vos articles avec leur référence, prix d'achat, prix de vente et quantité.&#x0a;• Définissez un « Seuil d'alerte » : lorsque le stock d'un produit passe en dessous de ce seuil, il s'affiche en rouge et remonte dans les alertes du tableau de bord.&#x0a;• Utilisez le bouton « EXPORTER CSV » pour exporter l'inventaire complet dans Excel."
                               LineHeight="22" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Guide 3 : Clients & Relations -->
            <materialDesign:Card Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="3. Répertoire des Clients" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="8,0,0,0" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Text="• Enregistrez vos clients fidèles ou partenaires commerciaux avec leurs coordonnées (téléphone, adresse).&#x0a;• Lors d'une vente, sélectionner un client permet d'associer la facture à son nom.&#x0a;• La barre de recherche permet de filtrer instantanément par nom ou numéro de téléphone."
                               LineHeight="22" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Guide 4 : Sauvegardes & Sécurité -->
            <materialDesign:Card Style="{StaticResource SectionCard}" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="24" Height="24" Foreground="#10B981" VerticalAlignment="Center" />
                        <TextBlock Text="4. Bonnes Pratiques de Sauvegarde" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="8,0,0,0" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Text="• Vos données sont stockées sur votre ordinateur sans passer par internet.&#x0a;• Il est recommandé d'aller dans « Paramètres » au moins une fois par semaine et de cliquer sur « SAUVEGARDER LA BASE » pour enregistrer une copie sur une clé USB ou un disque externe."
                               LineHeight="22" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>