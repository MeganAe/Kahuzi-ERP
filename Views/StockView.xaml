<UserControl x:Class="GestionCommerciale.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <!-- Contenu principal -->
        <DockPanel LastChildFill="True" Margin="16">

            <!-- Barre d'en-tête -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Gestion du stock" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />

                <TextBox Grid.Column="2" Style="{StaticResource SearchTextBox}"
                         Text="{Binding TexteRecherche, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                         VerticalAlignment="Center" Margin="0,0,12,0" />
            </Grid>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button Content="EXPORTER CSV"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ExporterCsvCommand}"
                        Margin="0,0,8,0" />
                <Button Content="+ NOUVEAU PRODUIT"
                        Style="{StaticResource PrimaryActionButton}"
                        Command="{Binding OuvrirNouveauFormulaireCommand}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding MessageErreur}" Foreground="{DynamicResource ValidationErrorBrush}"
                       Margin="0,0,0,8" TextWrapping="Wrap"
                       Visibility="{Binding MessageErreur, Converter={StaticResource StringToVisibilityConverter}}" />

            <materialDesign:Card Style="{StaticResource SectionCard}" Margin="0">
                <DataGrid ItemsSource="{Binding Produits}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          materialDesign:DataGridAssist.CellPadding="12,10"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="100" />
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" />
                        <DataGridTextColumn Header="Catégorie" Binding="{Binding Categorie}" Width="130" />
                        <DataGridTextColumn Header="Prix achat" Binding="{Binding PrixAchat, StringFormat={}{0:N0}}" Width="100" />
                        <DataGridTextColumn Header="Prix vente" Binding="{Binding PrixVente, StringFormat={}{0:N0}}" Width="100" />
                        <DataGridTemplateColumn Header="Stock" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                            Background="{Binding EnAlerte, Converter={StaticResource BoolToAlertBrushConverter}}">
                                        <TextBlock Text="{Binding QuantiteStock}" FontWeight="Medium" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.OuvrirEditionFormulaireCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="Modifier">
                                            <materialDesign:PackIcon Kind="PencilOutline" />
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.SupprimerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="Supprimer">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </DockPanel>

        <!-- Overlay formulaire ajout/édition -->
        <Grid Visibility="{Binding AfficherFormulaire, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#88000000">
            <materialDesign:Card Width="440" MaxHeight="600" Padding="24"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  UniformCornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding TitreFormulaire}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,16" />

                        <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Référence" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                        <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Nom du produit" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                        <TextBox Text="{Binding Categorie, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Catégorie" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Description" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PrixAchat, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Prix d'achat" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            <TextBox Grid.Column="2" Text="{Binding PrixVente, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Prix de vente" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding QuantiteStock, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Quantité en stock" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            <TextBox Grid.Column="2" Text="{Binding SeuilAlerte, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Seuil d'alerte" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </Grid>

                        <TextBlock Text="{Binding MessageErreur}" Foreground="{DynamicResource ValidationErrorBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="ANNULER" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding FermerFormulaireCommand}" Margin="0,0,8,0" />
                            <Button Content="ENREGISTRER" Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding EnregistrerCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
