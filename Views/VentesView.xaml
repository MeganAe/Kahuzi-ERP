<UserControl x:Class="GestionCommerciale.Views.VentesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <DockPanel LastChildFill="True" Margin="16">

            <TextBlock DockPanel.Dock="Top" Text="Ventes" Style="{StaticResource SectionTitle}" />

            <Button DockPanel.Dock="Top" Content="+ NOUVELLE VENTE" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryActionButton}"
                    Command="{Binding OuvrirNouvelleVenteCommand}" Margin="0,0,0,12" />

            <materialDesign:Card Style="{StaticResource SectionCard}" Margin="0">
                <DataGrid ItemsSource="{Binding Ventes}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          materialDesign:DataGridAssist.CellPadding="12,10"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="150" />
                        <DataGridTextColumn Header="Date" Binding="{Binding DateVente, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140" />
                        <DataGridTextColumn Header="Client" Binding="{Binding Client.NomComplet}" Width="160" />
                        <DataGridTextColumn Header="Paiement" Binding="{Binding ModePaiement}" Width="100" />
                        <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="90" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N0} FC}" Width="120" />
                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.AnnulerVenteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" ToolTip="Annuler la vente"
                                            Visibility="{Binding EstAnnulable, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <materialDesign:PackIcon Kind="CloseCircleOutline" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </DockPanel>

        <!-- Overlay nouvelle vente -->
        <Grid Visibility="{Binding AfficherFormulaire, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#88000000">
            <materialDesign:Card Width="620" MaxHeight="680" Padding="24"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  UniformCornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Nouvelle vente" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,16" />

                        <ComboBox ItemsSource="{Binding ClientsDisponibles}" SelectedItem="{Binding ClientChoisi}"
                                  DisplayMemberPath="NomComplet"
                                  materialDesign:HintAssist.Hint="Client" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,0,0,12" />

                        <ComboBox ItemsSource="{Binding ModePaiementListe}" SelectedItem="{Binding ModePaiement}"
                                  materialDesign:HintAssist.Hint="Mode de paiement" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,0,0,16" />

                        <TextBlock Text="Ajouter un produit" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" ItemsSource="{Binding ProduitsDisponibles}" SelectedItem="{Binding ProduitChoisi}"
                                      DisplayMemberPath="Nom"
                                      materialDesign:HintAssist.Hint="Produit" Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                            <TextBox Grid.Column="2" Text="{Binding QuantiteChoisie, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Qté" Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                            <Button Grid.Column="4" Content="AJOUTER" Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding AjouterAuPanierCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding MessageErreur}" Foreground="{DynamicResource ValidationErrorBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding MessageErreur, Converter={StaticResource StringToVisibilityConverter}}" />

                        <!-- Panier -->
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4" Padding="0" Margin="0,0,0,12">
                            <ItemsControl ItemsSource="{Binding Panier}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding NomProduit}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Quantite, StringFormat='x{0}'}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding PrixUnitaire, StringFormat={}{0:N0} FC}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding SousTotal, StringFormat={}{0:N0} FC}" FontWeight="Medium" VerticalAlignment="Center" />
                                            <Button Grid.Column="4" Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding DataContext.RetirerDuPanierCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="CloseCircleOutline" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="{Binding TotalPanier, StringFormat='Total : {0:N0} FC'}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   HorizontalAlignment="Right" Margin="0,0,0,20" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="ANNULER" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding FermerFormulaireCommand}" Margin="0,0,8,0" />
                            <Button Content="VALIDER LA VENTE" Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding ValiderVenteCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
