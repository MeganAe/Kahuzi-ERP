<UserControl x:Class="GestionCommerciale.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock Text="Tableau de bord — Kahuzi ERP" Style="{StaticResource SectionTitle}" Margin="16,16,16,0" />

            <!-- Cartes statistiques -->
            <UniformGrid Columns="4" Margin="8">

                <materialDesign:Card Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        <TextBlock Text="{Binding NombreProduits}" Style="{StaticResource MaterialDesignHeadline4TextBlock}" Foreground="{DynamicResource MaterialDesignBody}" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="Produits en stock" Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.7" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="AccountGroup" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        <TextBlock Text="{Binding NombreClients}" Style="{StaticResource MaterialDesignHeadline4TextBlock}" Foreground="{DynamicResource MaterialDesignBody}" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="Clients enregistrés" Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.7" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="CartOutline" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        <TextBlock Text="{Binding NombreVentes}" Style="{StaticResource MaterialDesignHeadline4TextBlock}" Foreground="{DynamicResource MaterialDesignBody}" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="Ventes réalisées" Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.7" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="CashMultiple" Width="28" Height="28" Foreground="{DynamicResource SecondaryHueMidBrush}" />
                        <TextBlock Text="{Binding ChiffreAffairesTotal, StringFormat={}{0:N0} FC}" Style="{StaticResource MaterialDesignHeadline4TextBlock}" Foreground="{DynamicResource MaterialDesignBody}" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="Chiffre d'affaires" Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.7" />
                    </StackPanel>
                </materialDesign:Card>

            </UniformGrid>

            <Grid Margin="8,8,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Alertes de stock -->
                <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="{DynamicResource ValidationErrorBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Alertes de stock" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="8,0,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ProduitsAlerteListe}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Nom}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding QuantiteStock, StringFormat='Reste : {0}'}"
                                                       Foreground="{DynamicResource ValidationErrorBrush}" FontWeight="Medium" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Aucune alerte 🎉" Opacity="0.6" Margin="0,8,0,0"
                                   Visibility="{Binding ProduitsEnAlerte, Converter={StaticResource ZeroToVisibleConverter}}" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- Dernières ventes -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="History" VerticalAlignment="Center" />
                            <TextBlock Text="Dernières ventes" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="8,0,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding DernieresVentes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Numero}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding Client.NomComplet}" Opacity="0.7" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat={}{0:N0} FC}"
                                                       VerticalAlignment="Center" FontWeight="Medium" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
